{
  "name": "bisca",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "expo:dev": "cross-env EXPO_PUBLIC_DOMAIN=10.0.2.2:5000 npx expo start",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix",
    "db:push": "drizzle-kit push",
    "server:dev": "cross-env NODE_ENV=development tsx --env-file=.env server/index.ts",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "cross-env NODE_ENV=production node server_dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:load": "npx artillery run tests/load/ws-scenario.yml"
  },
  "dependencies": {
    "@clerk/backend": "^3.2.0",
    "@clerk/clerk-expo": "^2.19.31",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.90.21",
    "@ungap/structured-clone": "^1.3.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "expo": "~55.0.5",
    "expo-blur": "~55.0.9",
    "expo-constants": "~55.0.7",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.8",
    "expo-haptics": "~55.0.8",
    "expo-image": "~55.0.6",
    "expo-image-picker": "~55.0.12",
    "expo-linear-gradient": "~55.0.8",
    "expo-linking": "~55.0.7",
    "expo-localization": "~55.0.8",
    "expo-location": "~55.1.2",
    "expo-router": "~55.0.5",
    "expo-secure-store": "~55.0.8",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-web-browser": "~55.0.9",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "i18n-js": "^4.5.3",
    "pg": "^8.20.0",
    "react": "^19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "0.7.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.21.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/express": "^5.0.6",
    "@types/react": "~19.2.2",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.0",
    "artillery": "^2.0.30",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "patch-package": "^8.0.1",
    "supertest": "^7.2.2",
    "typescript": "~5.9.2",
    "vitest": "^4.1.0"
  },
  "private": true
}
