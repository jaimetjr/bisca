DATABASE_URL=postgresql://user:password@localhost:5432/bisca
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
PORT=5000

# --- AdMob ---
# NOTE: .env is NOT uploaded to EAS builds (it's gitignored). For preview/
# production builds, set these in eas.json (per-profile "env") or as EAS
# environment variables. This file is for local runs + documentation.
#
# App ID (from AdMob → App settings, format ca-app-pub-XXXX~XXXX). REQUIRED at
# build time or the native SDK crashes on launch.
ADMOB_APP_ID_ANDROID=
ADMOB_APP_ID_IOS=
#
# Ad unit IDs (format ca-app-pub-XXXX/YYYY). If left empty the app falls back to
# Google's built-in TEST ad units, so you see test ads without configuring these.
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
# Rewarded ad unit IDs (cosmetic/convenience rewards only — never gameplay)
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
#
# Comma-separated device IDs that should always receive TEST ads (so you never
# serve yourself a real ad while testing). Emulators are auto-covered. Get a real
# phone's id from the logcat line the SDK prints on the first ad request.
EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=

# --- RevenueCat (in-app purchases) ---
# Platform-specific PUBLIC SDK keys from the RevenueCat dashboard. Leave empty
# for ads-only builds — the app skips purchases setup when no key is present.
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=

# Required: HMAC secret for signing auth session JWTs (>=16 chars, random)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Email verification + password reset (Resend). Without RESEND_API_KEY the
# 6-digit codes are logged to the server console instead of emailed (dev only).
RESEND_API_KEY=
# Sender address. Defaults to Resend's test sender, which only delivers to the
# email you registered with Resend. Use a verified domain for real users.
EMAIL_FROM=Bisca <onboarding@resend.dev>

# Required: HMAC secret for WebSocket reconnect tokens (>=16 chars, random)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RECONNECT_TOKEN_SECRET=

# Optional rate-limit overrides (per-IP create_room/min, per-WS msgs/10s)
# CREATE_ROOM_LIMIT_PER_MIN=5
# WS_MSG_LIMIT_PER_10S=30

# Room state backend: "memory" (default, lost on restart) or "redis" (persistent)
ROOM_STORE=memory
# Required when ROOM_STORE=redis
REDIS_URL=redis://localhost:6379
